name: Build APK
on:
  push:
    branches: [ main ]
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'
      - uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.22.0'
          channel: 'stable'
      - run: cp android/app/google-services.json /tmp/google-services.json || echo "no json"
      - run: rm -rf android
      - run: flutter create --platforms=android --org com.chatyo --project-name chatyo_ai .
      - run: sed -i 's/minSdk = flutter.minSdkVersion/minSdk = 23/g; s/minSdkVersion flutter.minSdkVersion/minSdkVersion 23/g' android/app/build.gradle android/app/build.gradle.kts || true
      - run: grep -q "google-services" android/settings.gradle || sed -i "s/id \"com.android.application\"/id \"com.android.application\"\n        id \"com.google.gms.google-services\" version \"4.4.2\" apply false/" android/settings.gradle
      - run: grep -q "google-services" android/app/build.gradle* || echo 'apply plugin: "com.google.gms.google-services"' >> android/app/build.gradle
      - run: cp /tmp/google-services.json android/app/google-services.json || echo "no json to restore"
      - run: flutter pub get
      - run: flutter build apk --release
      - uses: actions/upload-artifact@v4
        with:
          name: ChatYo-APK
          path: build/app/outputs/flutter-apk/app-release.apk